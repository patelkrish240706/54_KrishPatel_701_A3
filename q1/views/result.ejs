<!DOCTYPE html>
<html>
<head>
    <title>Registration Details</title>
</head>

<body>

<h2>Registration Successful</h2>

<table border="1" cellpadding="10">

    <tr>
        <th>Username</th>
        <td><%= data.username %></td>
    </tr>

    <tr>
        <th>Password</th>
        <td><%= data.password %></td>
    </tr>

    <tr>
        <th>Email</th>
        <td><%= data.email %></td>
    </tr>

    <tr>
        <th>Gender</th>
        <td><%= data.gender %></td>
    </tr>

    <tr>
        <th>Hobbies</th>
        <td>
            <%= Array.isArray(data.hobbies)
                ? data.hobbies.join(", ")
                : data.hobbies %>
        </td>
    </tr>

    <tr>
        <th>Profile Picture</th>
        <td>

            <img src="/uploads/<%= profilepic.filename %>"
                 width="150">

            <br>

            <a href="/download/<%= profilepic.filename %>">
                Download Profile Picture
            </a>

        </td>
    </tr>

    <tr>
        <th>Other Pictures</th>

        <td>

            <% otherpics.forEach(function(file) { %>

                <img src="/uploads/<%= file.filename %>"
                     width="120">

                <br>

                <a href="/download/<%= file.filename %>">
                    Download <%= file.originalname %>
                </a>

                <br><br>

            <% }) %>

        </td>

    </tr>

</table>

<br>

<a href="/">Back to Registration</a>

</body>
</html>