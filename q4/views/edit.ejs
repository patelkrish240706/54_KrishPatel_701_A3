<!DOCTYPE html>
<html>

<head>
    <title>Edit Employee</title>
</head>

<body>

<h2>Edit Employee</h2>

<form action="/edit/<%= employee._id %>" method="POST">

    <label>Name:</label>

    <input
        type="text"
        name="name"
        value="<%= employee.name %>"
    >

    <br><br>

    <label>Email:</label>

    <input
        type="email"
        name="email"
        value="<%= employee.email %>"
    >

    <br><br>

    <label>Department:</label>

    <input
        type="text"
        name="department"
        value="<%= employee.department %>"
    >

    <br><br>

    <label>Basic Salary:</label>

    <input
        type="number"
        name="basicSalary"
        value="<%= employee.basicSalary %>"
    >

    <br><br>

    <button type="submit">
        Update Employee
    </button>

</form>

<br>

<a href="/employees">Back</a>

</body>

</html>